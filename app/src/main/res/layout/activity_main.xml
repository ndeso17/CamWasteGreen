<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <!--
        Tidak ada PreviewView: kamera dipegang CameraService, bukan Activity.
        Panel ini hanya menampilkan status terukur dari registry service.
    -->
    <LinearLayout
        android:id="@+id/previewPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCameraState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/label_server_stopped"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPreviewHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/label_preview_hint"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Floating status chips (Maps-style) -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFpsInfo"
                style="@style/InfoText"
                android:text="FPS 20" />

            <TextView
                android:id="@+id/tvQualityInfo"
                style="@style/InfoText"
                android:layout_marginStart="8dp"
                android:text="Quality High" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnTogglePanel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_status_chip"
                android:src="@android:drawable/arrow_up_float"
                android:contentDescription="Expand controls"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:elevation="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvIpInfo"
            style="@style/InfoText"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:text="Stream offline" />

        <TextView
            android:id="@+id/tvUsbStatus"
            style="@style/InfoText"
            android:layout_marginTop="6dp"
            android:text="USB --" />
    </LinearLayout>

    <!-- Bottom sheet: peek = Start/Stop only -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="16dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="108dp"
        app:behavior_hideable="false"
        app:behavior_fitToContents="true"
        app:behavior_skipCollapsed="false">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_sheet_handle" />

<!-- Peek row: FrameLayout with centered shutter -->
        <FrameLayout
            android:id="@+id/layoutStartStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <!-- Left buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnSwitchCamera"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:src="@drawable/ic_flip"
                    android:contentDescription="Flip camera"
                    android:scaleType="centerInside"
                    android:padding="8dp" />

                <!--
                    Tombol kunci orientasi dihapus pada WP-20. Ia menyetel
                    SCREEN_ORIENTATION_UNSPECIFIED/SENSOR_* saat runtime,
                    sehingga orientasi tetap (CWG-06) bisa dilepas operator.
                -->
            </LinearLayout>

            <!-- Centered shutter -->
            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_btn_record_off"
                    android:id="@+id/btnRecordBg" />

                <View
                    android:id="@+id/btnRecordInner"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_btn_record_inner"
                    android:visibility="gone" />
            </FrameLayout>

        </FrameLayout>

        <!-- Expanded controls -->
        <LinearLayout
            android:id="@+id/expandedControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/SheetLabel"
                android:text="QUALITY" />

            <LinearLayout
                android:id="@+id/layoutQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnDecreaseQuality"
                    style="@style/ControlButton"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:text="−"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvQualityValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="High"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnIncreaseQuality"
                    style="@style/ControlButton"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:text="+"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                style="@style/SheetLabel"
                android:text="FPS" />

            <LinearLayout
                android:id="@+id/layoutFps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnDecreaseFps"
                    style="@style/ControlButton"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:text="−"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvFpsValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="20"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnIncreaseFps"
                    style="@style/ControlButton"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:text="+"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                style="@style/SheetLabel"
                android:text="@string/label_interface" />

            <!--
                Pilihan interface jalur streaming. Hanya berlaku pada start
                server berikutnya; saat stream berjalan kontrol dinonaktifkan
                (WP-35, T-100).
            -->
            <RadioGroup
                android:id="@+id/groupInterface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/rbInterfaceAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/interface_all"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbInterfaceWifiLan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/interface_wifi_lan"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbInterfaceUsbTethering"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/interface_usb_tethering"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btnApplyInterface"
                style="@style/ControlButton.Green"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:text="@string/action_apply_interface" />

            <TextView
                android:id="@+id/tvInterfaceHint"
                style="@style/InfoText"
                android:layout_width="match_parent"
                android:layout_marginBottom="16dp"
                android:text="@string/label_interface_locked" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
